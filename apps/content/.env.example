# Use your existing PostgreSQL database. This app never creates a database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CONTENT_SERVER_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
